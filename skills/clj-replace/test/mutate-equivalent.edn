;; Surviving mutants of clj-replace.bb judged equivalent (same behaviour as
;; the original), read by test/mutate.bb. Matched by trimmed source line and
;; operator, so line numbers can move. Two are slower but behave the same;
;; bb bench rejects those. Remove an entry when bb mutate reports it stale.
[{:source-line "(reduce (fn [k c] (if (layout? c) k (inc k))) 0 (n/children nd)))"
  :from "inc"
  :to "dec"
  :reason "significant-count is only compared between the two nodes, computed the same way on both sides, so a negated count compares the same"}

 {:source-line "(reduce (fn [k c] (if (layout? c) k (inc k))) 0 (n/children nd)))"
  :from "0"
  :to "1"
  :reason "significant-count is only compared between the two nodes; a shared offset does not change equality"}

 {:source-line "(def ^:private placeholder-prefix (str (char 0) \"arg\"))"
  :from "0"
  :to "1"
  :reason "the placeholder prefix only has to be a symbol name no source text produces; (char 1) qualifies as well as (char 0)"}

 {:source-line "(def ^:private placeholder-prefix (str (char 0) \"arg\"))"
  :from "\"arg\""
  :to "\"\""
  :reason "the NUL character alone already makes placeholders unreadable; the \"arg\" suffix is for readability"}

 {:source-line "{:ok true :value (if stable? (stable-gensyms v) v)})"
  :from "if"
  :to "if-not"
  :reason "renames gensyms on every node even when old-string has no #(); placeholders cannot collide with source symbols, so results are the same, only slower: bb bench fails it (deep-no-match about 1.9x)"}

 {:source-line "(when-not (and (= 1 (count nodes)) (not= :comment (n/tag (first nodes))))"
  :from "first"
  :to "last"
  :reason "the and checks (= 1 (count nodes)) first, so first and last are the same element"}

 {:source-line "{:line \"?\" :column \"?\"})))"
  :from "\"?\""
  :to "\"\""
  :reason "fallback when the zipper has no position; unreachable with :track-position? true"}

 {:source-line "stable? (and (:ok raw) (has-gensym? (:value raw)))"
  :from "and"
  :to "or"
  :reason "same as the if/if-not mutant in safe-value: gensyms renamed on every node, same results, only slower; bb bench fails it"}

 {:source-line "(when-not (or (empty? (:nodes new-parse)) (nil? (one-form-problem \"new-string\" (:nodes new-parse))))"
  :from "\"new-string\""
  :to "\"\""
  :reason "the label only builds a message that this nil? check throws away"}

 {:source-line "target (first (:nodes old-parse))"
  :from "first"
  :to "last"
  :reason "old-string was checked to hold exactly one node"}

 {:source-line "(first (:nodes new-parse)))"
  :from "first"
  :to "last"
  :reason "new-string was checked to hold exactly one node"}

 {:source-line "(let [{:keys [z loc]} (first exact)]"
  :from "first"
  :to "last"
  :reason "this branch runs only when exact has exactly one element"}

 {:source-line "(> (count exact) 1)"
  :from ">"
  :to ">="
  :reason "a count of 1 is handled by the branch above, so > 1 and >= 1 select the same cases here"}]
